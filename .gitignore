# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments and local configuration
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Python builds and packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Notebooks
.ipynb_checkpoints/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Generated simulation outputs (keep reproducible scripts/configs in Git)
results/
outputs/
logs/
*.log

# Large/local datasets and unpublished source documents
data/raw/
data/private/
*.sqlite
*.sqlite3

# Temporary files
*.tmp
*.bak
~$*
